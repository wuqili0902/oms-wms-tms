# ── OMS+WMS+TMS Environment Variables ────────────────────────────────────────

# Application
APP_NAME=oms-wms-tms
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Bootstrap password for the seeded "admin" user.
# Leave empty in production to get a random one-time password printed at first startup.
ADMIN_INIT_PASSWORD=

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oms_wms_tms
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/oms_wms_tms
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# OpenTelemetry / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Sentry (production error capture)
SENTRY_DSN=
ENVIRONMENT=development

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@oms-wms-tms.local

# Outbox dispatch
OUTBOX_DISPATCH_URL=http://localhost:8000/api/v1/events/ingest

# Kdniao (快递鸟) electronic waybill.  Fill both to call the real 快递鸟 API
# (电子面单下单 + 轨迹查询): the waybill number is the carrier's and
# GET /logistics/waybill/{tracking}/track answers with source=kdniao.
# Left empty, 下单 still succeeds but the number is one this server assembled
# (response says tracking_source=local_placeholder — the carrier has never seen
# it), and 轨迹查询 answers 501 instead of inventing a delivery state.
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=

# Demo tracking data (轨迹 / 运费询价), OFF by default.
# With no 快递鸟 credentials and no CARRIER_API_ENDPOINTS, those two endpoints
# answer 501.  Setting this true makes them answer a generator that picks the
# delivery state out of a hash of the waybill number — no shipment is consulted —
# so every row it returns is labelled 演示数据 / source=mock.  Use it to develop
# screens, not to answer a customer: 未配置时接口答的"已签收"和真实签收没有关系。
LOGISTICS_MOCK_ENABLED=false

# Amazon SP-API — LWA credentials (NOT AWS Access Keys). Get these from the
# SP-API developer console: an LWA app's Client ID / Client Secret plus the
# refresh token issued to your selling account.  Order import works without
# them (you paste SP-API's Order object); credentials are what the console
# reports as 已配置, and they switch the tracking handover's sync_status from
# not_configured to queued (recorded and ready for upload — the upload call
# itself, PUT /orders/v0/orders/{orderId}/tracking, is not implemented yet).
# Read by GET /connectors/status as name + set/unset only; values never reach
# the browser, so they are never typed into a web form.
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_REGION=us

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# PDA offline mode
PDA_LOCAL_DB_PATH=wms_pda.db

# Push notifications (Firebase Cloud Messaging)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# Carrier API endpoints (JSON dict: {"carrier_code": "url"})
CARRIER_API_ENDPOINTS={}

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
