# ── OMS+WMS+TMS Environment Variables ────────────────────────────────────────

# Application
APP_NAME=oms-wms-tms
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oms_wms_tms
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/oms_wms_tms

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (for Celery + Outbox dispatch)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# OpenTelemetry / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces  # Jaeger / OTel Collector

# Sentry (production error capture)
SENTRY_DSN=                              # leave blank to disable in dev
ENVIRONMENT=development                  # development | staging | production
