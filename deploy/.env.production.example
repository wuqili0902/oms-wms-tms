# Production environment template for OMS-WMS-TMS.
# Copy to deploy/.env (or your orchestrator's secret store) and fill in real values.
# NEVER commit real secrets. docker-compose.prod.yml reads these via ${VAR}.

# --- Core security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
DEBUG=false
# Comma/JSON list of allowed frontend origins, e.g. ["https://oms.example.com"]
CORS_ORIGINS=["https://oms.example.com"]

# --- Database (PostgreSQL) ---
PG_USER=postgres
PG_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# Optional: point DATABASE_URL/DATABASE_SYNC_URL here if not using the bundled compose service
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@pg-host:5432/oms_wms_tms
# DATABASE_SYNC_URL=postgresql://postgres:PASSWORD@pg-host:5432/oms_wms_tms

# --- Redis ---
# REDIS_URL=redis://redis:6379/0

# --- Error capture / observability ---
# Sentry: create project -> get DSN
SENTRY_DSN=
ENVIRONMENT=production
# OpenTelemetry collector endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# --- SMTP (email notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@oms.example.com

# --- Push notifications (Firebase Cloud Messaging, optional) ---
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json

# --- Carrier API endpoints (JSON dict carrier_code -> URL) ---
# CARRIER_API_ENDPOINTS={"sf_express":"https://api.example.com/carrier/sf","zto":"https://api.example.com/carrier/zto"}

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Misc ---
OUTBOX_DISPATCH_URL=http://app:8000/api/v1/events/ingest
PDA_LOCAL_DB_PATH=/data/wms_pda.db
LOG_LEVEL=info
LOG_FORMAT=json